# SiliconFlow API Key for the AI chat proxy.
# Set this as a Cloudflare Pages secret.
SILICONFLOW_API_KEY=sk-your-api-key-here

# Required in production. Use at least 32 random characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional comma-separated usernames that should become admins on registration.
# Existing users with role=admin keep their admin access.
ADMIN_USERNAMES=admin
